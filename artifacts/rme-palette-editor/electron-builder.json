{
  "appId": "com.rmepaletteeditor.app",
  "productName": "RME Palette Generator",
  "directories": {
    "buildResources": "assets",
    "output": "dist"
  },
  "files": [
    "dist/electron/**/*",
    "dist/public/**/*",
    "node_modules/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "certificateFile": null,
    "certificatePassword": null,
    "signingHashAlgorithms": ["sha256"],
    "sign": "./customSign.js",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "RME Palette Generator"
  },
  "portable": {
    "artifactName": "${productName}-${version}.exe"
  }
}
